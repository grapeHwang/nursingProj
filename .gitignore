# --- Python 관련 ---
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
env/
.env
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/

# --- Google Cloud & Vertex AI 인증 관련 ---
# 서비스 계정 키 파일 (JSON)이 노출되지 않도록 설정
*.json
!scenarios/*.json  # 단, 시나리오 폴더 내의 JSON은 제외하고 관리하고 싶을 때

# --- IDE (VS Code, PyCharm) ---
.vscode/
.idea/

# --- 운영체제 관련 ---
.DS_Store
Thumbs.db

# --- 프로젝트 특정 ---
# 대화 녹음이나 로그 데이터가 서버에 올라가지 않도록 설정
logs/*.txt
logs/*.json
recordings/
*.log

# --- Streamlit ---
.streamlit/config.toml